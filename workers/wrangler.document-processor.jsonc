{
  "$schema": "../node_modules/wrangler/config-schema.json",

  // Dedicated worker for the async document-processing queue.
  // Top-level = personal v4 consumer.
  "name": "smartfin-document-processor-v4",
  "account_id": "e8bc57519de766f2b7f4f4d1b333ee2e",
  "compatibility_date": "2026-03-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "document-processor.ts",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartfin-db-v4",
      "database_id": "8b3e170a-4ef2-412c-92cd-a7065b6832a6",
      "migrations_dir": "../drizzle/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "smartfin-files-v4"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c04e64ab7222455a87ceb495b6fa65ef"
    }
  ],

  "queues": {
    "consumers": [
      {
        "queue": "smartfin-doc-processor-queue-v4",
        "max_batch_size": 1,
        "max_concurrency": 2,
        "max_retries": 3,
        "max_batch_timeout": 60,
        "dead_letter_queue": "smartfin-doc-processor-dlq-v4"
      }
    ]
  },

  "vars": {
    "APP_ENV": "personal-v4",
    // Used by the Lark review-card notifier (pushed from this worker at
    // ready_for_review) to build the "open in app" link.
    "BETTER_AUTH_URL": "https://smartfin-v4.wangchang0409.workers.dev",
    "LLM_PROVIDER": "heuristic",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "OCR_IMAGE_PROVIDER": "openai",
    "OCR_PROMPT_VERSION": "v1",
    "OPENAI_VISION_MODEL": "gpt-4o",
    // Lark OpenAPI host. Use https://open.larksuite.com for international Lark.
    "LARK_BASE_URL": "https://open.feishu.cn",
    // OCR.space "OCR API" route (ocrStrategy=ocr_api) — the async pipeline runs
    // text extraction here, so OCR_SPACE_API_KEY must be set on THIS worker too
    // (wrangler secret put OCR_SPACE_API_KEY -c workers/wrangler.document-processor.jsonc).
    "OCR_SPACE_ENGINE": "3"
  },

  "ai": {
    "binding": "AI",
    "remote": true
  },

  "observability": {
    "enabled": true
  }
}
