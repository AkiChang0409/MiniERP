{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // v4 默认开发/测试环境
  "name": "smartfin-v4",
  "account_id": "c09bb2823904032b6ec648b23411f2e0",
  "compatibility_date": "2026-03-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartfin-db-v4",
      "database_id": "e802fb76-fdbf-4884-a2f6-bc2d826b8b50",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "smartfin-files-v4"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "7bd4733bae7c460ba265549b3f468e1f"
    }
  ],

  // OCR_QUEUE 目前仍可保留，因为 legacy 路由可能还引用。
  // 后续确认 /api/upload/* 等 legacy 路由清掉后，再删除 OCR_QUEUE。
  "queues": {
    "producers": [
      {
        "binding": "OCR_QUEUE",
        "queue": "smartfin-ocr-queue-v4"
      },
      {
        "binding": "DOCUMENT_QUEUE",
        "queue": "smartfin-doc-processor-queue-v4"
      }
    ]
  },
  "vars": {
    "APP_ENV": "personal-v4",
    "BETTER_AUTH_URL": "https://smartfin-v4.aki-wang.workers.dev",
    "EMAIL_FROM": "SmartFin <onboarding@resend.dev>",
    "LLM_PROVIDER": "heuristic",
    // Agent orchestrator uses structured/tool JSON — prefer the OpenAI model
    // (OPENAI_API_KEY is already deployed) over Workers AI on the app worker for
    // reliable output. Workers AI still serves the doc-processor worker.
    "LLM_SKIP_WORKERS": "true",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "OCR_IMAGE_PROVIDER": "openai",
    "OCR_PROMPT_VERSION": "v1",
    "OPENAI_VISION_MODEL": "gpt-4o",
    // Lark OpenAPI host. Use https://open.larksuite.com for international Lark.
    "LARK_BASE_URL": "https://open.larksuite.com",
    "LARK_BITABLE_APP_TOKEN": "HO6ebX2araSa7Xsw2Rrj17DYpsd",
    "LARK_BP_TABLE_ID": "tblsYri9cgxgfYrB",
    "LARK_BP_CONTACT_TABLE_ID": "tblZcoJ7hVTWVk1b",
    // Legacy DocHub/QC table ids in the shared Bitable Base.
    "LARK_DOCHUB_TABLE_ID": "tblQ4XMPWLVALfrF",
    "LARK_PROJECT_TABLE_ID": "tblQzG5SD2URlzs6",
    "LARK_TASK_TABLE_ID": "tblW3ug6R6JTDPvd",
    "LARK_SUPPLIER_TABLE_ID": "tblsYri9cgxgfYrB",
    "LARK_DICT_TABLE_ID": "tblJcL3sRLYqhX7G",
    // OCR.space "OCR API" route (ocrStrategy=ocr_api). Engine 3 = auto-language LSTM.
    "OCR_SPACE_ENGINE": "3"
    // OPENAI_API_KEY: set via wrangler secret / .dev.vars — do not commit here
    // OCR_SPACE_API_KEY: set via wrangler secret / .dev.vars — do not commit here
  },

  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },

  "ai": {
    "binding": "AI",
    "remote": true
  },

  "workers_dev": true,
  "preview_urls": true,

  // 公司开发环境配置
  "env": {
    "company-dev": {
      "account_id": "<COMPANY_CLOUDFLARE_ACCOUNT_ID>",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "smartfin-db-company-dev",
          "database_id": "<COMPANY_DEV_D1_DATABASE_ID>",
          "migrations_dir": "drizzle/migrations"
        }
      ],

      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "smartfin-files-company-dev"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "<COMPANY_DEV_KV_NAMESPACE_ID>"
        }
      ],

      "queues": {
        "producers": [
          {
            "binding": "OCR_QUEUE",
            "queue": "smartfin-ocr-queue-company-dev"
          },
          {
            "binding": "DOCUMENT_QUEUE",
            "queue": "smartfin-doc-processor-queue-company-dev"
          }
        ]
      },

      "vars": {
        "APP_ENV": "company-dev",
        "BETTER_AUTH_URL": "https://smartfin-company-dev.<company-workers-subdomain>.workers.dev",
        "EMAIL_FROM": "SmartFin <onboarding@resend.dev>",
        "LLM_PROVIDER": "heuristic",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
        "OCR_IMAGE_PROVIDER": "openai",
        "OCR_PROMPT_VERSION": "v1",
        "OPENAI_VISION_MODEL": "gpt-4o",
        // Lark OpenAPI host. Use https://open.larksuite.com for international Lark.
        "LARK_BASE_URL": "https://open.feishu.cn",
        // Bitable-as-source-of-truth Base/table ids. These are identifiers, not secrets.
        "LARK_BITABLE_APP_TOKEN": "HO6ebX2araSa7Xsw2Rrj17DYpsd",
        "LARK_BP_TABLE_ID": "tblsYri9cgxgfYrB",
        "LARK_BP_CONTACT_TABLE_ID": "tblZcoJ7hVTWVk1b",
        "LARK_PROJECT_TABLE_ID": "tblQzG5SD2URlzs6",
        "LARK_TASK_TABLE_ID": "tblW3ug6R6JTDPvd",
        // OCR.space "OCR API" route. OCR_SPACE_API_KEY set via wrangler secret.
        "OCR_SPACE_ENGINE": "3"
      },

      "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
      },

      "ai": {
        "binding": "AI",
        "remote": true
      },

      "workers_dev": true,
      "preview_urls": true
    },

    "production": {
      "account_id": "<COMPANY_CLOUDFLARE_ACCOUNT_ID>",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "smartfin-db-prod",
          "database_id": "<COMPANY_PROD_D1_DATABASE_ID>",
          "migrations_dir": "drizzle/migrations"
        }
      ],

      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "smartfin-files-prod"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "<COMPANY_PROD_KV_NAMESPACE_ID>"
        }
      ],

      "queues": {
        "producers": [
          {
            "binding": "OCR_QUEUE",
            "queue": "smartfin-ocr-queue-prod"
          },
          {
            "binding": "DOCUMENT_QUEUE",
            "queue": "smartfin-doc-processor-queue-prod"
          }
        ]
      },

      // 产品生产环境配置
      // 生产环境建议强制走异步队列，避免同步调用导致的性能问题或请求超时。
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://smartfin.<company-domain>.com",
        "EMAIL_FROM": "SmartFin <finance@<company-domain>.com>",
        "LLM_PROVIDER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
        "OCR_IMAGE_PROVIDER": "openai",
        "OCR_PROMPT_VERSION": "v1",
        "OPENAI_VISION_MODEL": "gpt-4o",
        // Lark OpenAPI host. Use https://open.larksuite.com for international Lark.
        "LARK_BASE_URL": "https://open.feishu.cn",
        // Bitable-as-source-of-truth Base/table ids. These are identifiers, not secrets.
        "LARK_BITABLE_APP_TOKEN": "HO6ebX2araSa7Xsw2Rrj17DYpsd",
        "LARK_BP_TABLE_ID": "tblsYri9cgxgfYrB",
        "LARK_BP_CONTACT_TABLE_ID": "tblZcoJ7hVTWVk1b",
        "LARK_PROJECT_TABLE_ID": "tblQzG5SD2URlzs6",
        "LARK_TASK_TABLE_ID": "tblW3ug6R6JTDPvd",
        // OCR.space "OCR API" route. OCR_SPACE_API_KEY set via wrangler secret.
        "OCR_SPACE_ENGINE": "3",

        // 生产环境建议强制走异步队列
        "DOCUMENT_QUEUE_FORCE_ASYNC": "true"
      },

      "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
      },

      "ai": {
        "binding": "AI",
        "remote": true
      },

      "workers_dev": false,
      "preview_urls": false
    }
  }
}
